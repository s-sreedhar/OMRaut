# Auto detect text files and perform LF normalization on checkout
* text=auto

# Source code & configs (enforce LF)
*.py text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.csv text eol=lf
*.spec text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf

# Windows-specific scripts & installer configurations (require CRLF)
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.iss text eol=crlf

# Binary files (prevent Git from modifying line endings or diffing as text)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.exe binary
*.dll binary
*.pyd binary
*.pyc binary
*.db binary
*.sqlite binary
*.sqlite3 binary
