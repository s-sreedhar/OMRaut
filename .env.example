# Build variables for installer/build.ps1.
# This file is a reference only; the build script does not load .env files.
# Set these values in the PowerShell session or CI environment before building.

# Optional path to Python 3.11, 3.12, or 3.13. Defaults to `python` on PATH.
OMR_PYTHON=

# Optional HTTPS Velopack feed URL. Leave blank to build with updates disabled.
OMR_UPDATE_SOURCE_URL=
